{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "overrides": [
    {
      "files": ["src/ui/**", "src/app/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["@/data", "@/data/*", "**/data/*"], "message": "Screens and pages never talk to the database. Go through src/business." }
        ] }]
      }
    },
    {
      "files": ["src/ui/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["@/data", "@/data/*", "**/data/*"], "message": "Screens and pages never talk to the database. Go through src/business." },
          { "group": ["@/app/*"], "message": "UI must not depend on pages." }
        ] }]
      }
    },
    {
      "files": ["src/ui/components/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["@/data", "@/data/*", "@/app/*", "@/business/*", "@/ui/features/*"], "message": "Reusable components know nothing about the event, its rules or the database." }
        ] }]
      }
    },
    {
      "files": ["src/business/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["@/ui/*", "@/app/*", "react", "next/*", "@supabase/*"], "message": "Business rules must not depend on the UI or on Supabase directly. Use src/data." }
        ] }]
      }
    },
    {
      "files": ["src/data/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["@/ui/*", "@/app/*", "@/business/*"], "message": "The data layer must not depend on the layers above it." }
        ] }]
      }
    }
  ]
}
