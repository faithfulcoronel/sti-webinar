# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API keys). Never commit .env.local.

# Public values: safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# SECRET. Server code only (src/data/supabaseAdmin.ts). It bypasses Row Level Security.
# Use the "secret" key (sb_secret_...) or the legacy service_role key.
# Never add NEXT_PUBLIC_ to this name and never show it on a projector.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Emails allowed to open /organizer, separated by commas.
# Each one must also exist as a user in Supabase Authentication.
ORGANIZER_EMAILS=organizer@example.com
