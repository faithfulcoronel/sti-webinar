# Copy to .env.local. NEVER commit real values. NEVER prefix the service role key with NEXT_PUBLIC_.

# Public values (safe to ship to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only secret. Used ONLY in server code (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails allowed to open /organizer (must also exist in Supabase Auth).
ORGANIZER_EMAILS=organizer@example.com

# Local rehearsal only: store registrations in memory instead of Supabase.
# Ignored (and refused) when NODE_ENV=production.
# DEMO_STORE=memory
